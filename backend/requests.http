### 1. Health check
GET http://localhost:8080/

> {%
    client.test("server is running", function () {
        client.assert(response.status === 200, "expected 200 OK");
    });
%}

### 2. All spots
GET http://localhost:8080/api/spots

> {%
    client.test("there are 18 spots", function () {
        client.assert(response.status === 200, "expected 200 OK");
        client.assert(response.body.length === 18, "expected 18 spots");
    });
    client.test("the last spot (C6) is unavailable", function () {
        const last = response.body[response.body.length - 1];
        client.assert(last.label === "C6" && last.status === "UNAVAILABLE", "C6 must be UNAVAILABLE");
    });
%}

### 3. Free spots (remembers the id of the first one)
GET http://localhost:8080/api/spots?status=free

> {%
    client.test("only FREE spots are returned", function () {
        client.assert(response.body.every(s => s.status === "FREE"), "all spots must be FREE");
    });
    client.global.set("id", response.body[0].id);
%}

### 4. Statistics
GET http://localhost:8080/api/spots/stats

> {%
    client.test("statistics add up", function () {
        const s = response.body;
        client.assert(s.total === 18, "total must be 18");
        client.assert(s.unavailable === 1, "one spot is unavailable");
        client.assert(s.free + s.reserved + s.occupied + s.unavailable === s.total, "numbers must add up");
    });
%}

### 5. One spot
GET http://localhost:8080/api/spots/5

> {%
    client.test("spot A5", function () {
        client.assert(response.body.label === "A5", "expected A5");
    });
%}

### 6. Unknown spot -> 404
GET http://localhost:8080/api/spots/999

> {%
    client.test("unknown spot returns 404", function () {
        client.assert(response.status === 404, "expected 404");
    });
%}

### 7. Reserve the free spot (from request 3)
POST http://localhost:8080/api/spots/{{id}}/reserve
Content-Type: application/json

{ "driver": "ana" }

> {%
    client.test("the spot is reserved by ana", function () {
        client.assert(response.status === 200, "expected 200 OK");
        client.assert(response.body.status === "RESERVED", "expected RESERVED");
        client.assert(response.body.reservedBy === "ana", "expected ana");
    });
%}

### 8. Another driver tries the same spot -> 409
POST http://localhost:8080/api/spots/{{id}}/reserve
Content-Type: application/json

{ "driver": "marko" }

> {%
    client.test("a second reservation is rejected", function () {
        client.assert(response.status === 409, "expected 409 Conflict");
    });
%}

### 9. Confirm arrival
POST http://localhost:8080/api/spots/{{id}}/confirm
Content-Type: application/json

{ "driver": "ana" }

> {%
    client.test("the spot is occupied", function () {
        client.assert(response.body.status === "OCCUPIED", "expected OCCUPIED");
    });
%}


### 10. Leave the spot
POST http://localhost:8080/api/spots/{{id}}/release
Content-Type: application/json

{ "driver": "ana" }

> {%
    client.test("the spot is free again", function () {
        client.assert(response.body.status === "FREE", "expected FREE");
    });
%}

### 11. Live updates (WebSocket)
WEBSOCKET ws://localhost:8080/ws/spots
