### How to use this file:
### 1. Run Application.kt. 2. Run request 8 first (WebSocket): it shows which spots are free ("type":"free") and their ids.
### 3. Put the id of a free spot into @id below, then run the requests 1 to 7 in order.
@id = 1
@plate = KG-123-AB
@otherPlate = KG-777-ZZ

### 1. Health check
GET http://localhost:8080/

> {%
    client.test("server is running", function () {
        client.assert(response.status === 200, "expected 200 OK");
    });
%}

### 2. Park in the spot
POST http://localhost:8080/api/spots/{{id}}/occupy
Content-Type: application/json

{ "licensePlate": "{{plate}}" }

> {%
    client.test("the spot is occupied by our plate", function () {
        client.assert(response.status === 200, "expected 200 OK (if 409: the spot is not free, change @id)");
        client.assert(response.body.status.type === "occupied", "expected occupied");
        client.assert(response.body.status.licensePlate === "KG-123-AB", "expected our plate");
    });
%}

### 3. Another driver tries the same spot -> 409
POST http://localhost:8080/api/spots/{{id}}/occupy
Content-Type: application/json

{ "licensePlate": "{{otherPlate}}" }

> {%
    client.test("a second driver is rejected", function () {
        client.assert(response.status === 409, "expected 409 Conflict");
    });
%}

### 4. An invalid license plate -> 400
POST http://localhost:8080/api/spots/{{id}}/occupy
Content-Type: application/json

{ "licensePlate": "abc" }

> {%
    client.test("an invalid plate is rejected", function () {
        client.assert(response.status === 400, "expected 400 Bad Request");
    });
%}

### 5. An unknown spot -> 404
POST http://localhost:8080/api/spots/999/occupy
Content-Type: application/json

{ "licensePlate": "{{plate}}" }

> {%
    client.test("an unknown spot returns 404", function () {
        client.assert(response.status === 404, "expected 404");
    });
%}

### 6. Leave with someone else's plate -> 409
POST http://localhost:8080/api/spots/{{id}}/release
Content-Type: application/json

{ "licensePlate": "{{otherPlate}}" }

> {%
    client.test("only the car that is parked there can leave", function () {
        client.assert(response.status === 409, "expected 409 Conflict");
    });
%}

### 7. Leave the spot
POST http://localhost:8080/api/spots/{{id}}/release
Content-Type: application/json

{ "licensePlate": "{{plate}}" }

> {%
    client.test("the spot is free again", function () {
        client.assert(response.status === 200, "expected 200 OK");
        client.assert(response.body.status.type === "free", "expected free");
    });
%}

### 8. Live updates (WebSocket): the full list arrives at once, then after every change
WEBSOCKET ws://localhost:8080/ws/spots
